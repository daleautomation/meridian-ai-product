{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/operator/morning-brief",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/operator/nightly-review",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "app/api/operator/morning-brief/route.ts": {
      "maxDuration": 60
    },
    "app/api/operator/nightly-review/route.ts": {
      "maxDuration": 60
    }
  }
}
