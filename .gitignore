# --- Dependencies ----------------------------------------------------------
node_modules

# --- Build outputs ---------------------------------------------------------
.next
dist
build
coverage
out
*.tsbuildinfo

# --- Environment / secrets -------------------------------------------------
.env
.env.local
.env.local*
.env.*.local

# --- OS / editor -----------------------------------------------------------
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# --- Local runtime state ---------------------------------------------------
.meridian/

# --- Deploy ----------------------------------------------------------------
.vercel/output

# --- Generated artifacts ---------------------------------------------------
# generated/ is the canonical home for new generated outputs. Anything in it
# should never be committed — except the directory scaffolding (subdir markers
# and READMEs) so the tree exists on a fresh clone.
generated/**/*
!generated/recovery-briefs/
!generated/exports/
!generated/reports/
!generated/snapshots/
!generated/**/.gitkeep
!generated/**/README.md

# Legacy generated outputs that still live under data/ for runtime reasons.
# Existing committed copies are preserved (use `git rm --cached <path>` to
# detach individually); these patterns only stop *future* writes from being
# committed.
data/snapshots/*.json
data/recovery-briefs/**/*.html
data/recovery-briefs/**/*.json
data/usage-events.jsonl
data/pipelineJobHistory.json
!data/recovery-briefs/.gitkeep
!data/snapshots/.gitkeep
data/crm-contacts/
data/crm-import-jobs/
data/crmImportJobs.json
data/crmContacts.json
data/crmImportRollbacks/

# Raw county exports. Directory scaffolding stays in git via .gitkeep;
# any real data file (CSV / XLSX / Parquet / JSON) is intentionally
# local-only so real property data never ships to the remote.
data/raw/**/*.csv
data/raw/**/*.tsv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.parquet
data/raw/**/*.json
data/raw/**/*.gz
data/raw/**/*.zip
.vercel
.env*.local

# --- Workspace runtime state (local-only) ----------------------------------
# Per-customer weekly snapshots written by scripts/generate-weekly-state.ts.
# These belong on the founder's machine + production filesystem, not git.
data/weekly-state/
# Append-only outcome capture history. Per-customer JSON, durable, never
# committed (production reads/writes its own copy on disk).
data/outcomes/
data/backups/*.json
data/backups/*.json
